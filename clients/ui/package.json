{
  "name": "@muxvia/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/entries/appStyles.css",
    "./preview-worker": "./public/muxvia-file-preview-sw.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "proto": "npm run proto:api && npm run proto:wire",
    "proto:api": "protoc --es_out=src/generated --es_opt=target=ts,import_extension=none -I ../../proto ../../proto/apipb/*.proto ../../proto/bindingpb/client_binding.proto ../../proto/remoteauthpb/remote_auth.proto ../../proto/cloud/v1/*.proto && perl -0pi -e 's/\\s*\\z/\\n/' src/generated/apipb/*_pb.ts src/generated/bindingpb/*_pb.ts src/generated/remoteauthpb/*_pb.ts src/generated/cloud/v1/*_pb.ts",
    "proto:wire": "protoc --es_out=src/generated/wirepb --es_opt=target=ts,import_extension=none -I ../../proto/wirepb ../../proto/wirepb/terminal.proto && perl -0pi -e 's/\\s*\\z/\\n/' src/generated/wirepb/terminal_pb.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.12.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.5.0",
    "jsdom": "27.4.0",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.5"
  },
  "peerDependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.0",
    "@types/three": "0.184.1",
    "@xterm/addon-canvas": "0.7.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "5.5.0",
    "highlight.js": "11.11.1",
    "i18next": "^26.3.6",
    "lucide-react": "1.14.0",
    "react-i18next": "^17.0.9",
    "three": "0.184.0"
  }
}
