{
  "name": "@termx/remote-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "proto": "npm run proto:runtime && npm run proto:wire",
    "proto:runtime": "protoc --plugin=protoc-gen-es=./node_modules/.bin/protoc-gen-es --es_out=src/generated/runtimepb --es_opt=target=ts,import_extension=none -I ../proto/runtimepb ../proto/runtimepb/runtime.proto && perl -0pi -e 's/\\s*\\z/\\n/' src/generated/runtimepb/runtime_pb.ts",
    "proto:wire": "protoc --plugin=protoc-gen-es=./node_modules/.bin/protoc-gen-es --es_out=src/generated/wirepb --es_opt=target=ts,import_extension=none -I ../proto/wirepb ../proto/wirepb/terminal.proto && perl -0pi -e 's/\\s*\\z/\\n/' src/generated/wirepb/terminal_pb.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.12.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.5.0",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.13",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@types/three": "^0.184.1",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.14.0",
    "three": "^0.184.0"
  }
}
