{
  "name": "termx-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "clients/ui",
    "clients/mobile",
    "private/cloud/web-controller/web"
  ],
  "devDependencies": {
    "esbuild": "0.27.7",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "overrides": {
    "@capacitor/core": "8.3.2",
    "@types/node": "25.6.2",
    "@types/three": {
      "fflate": "0.8.2"
    },
    "brace-expansion@^5": "5.0.6",
    "fs-extra@^11": "11.3.5",
    "lru-cache@^11": "11.3.6",
    "semver@^7": "7.7.4",
    "undici-types": "7.19.2"
  },
  "scripts": {
    "proto": "npm run proto --workspace @termx/ui && npm run proto --workspace @termx/web-controller",
    "test": "npm test --workspace @termx/ui && npm test --workspace @termx/mobile",
    "typecheck": "npm run typecheck --workspace @termx/ui",
    "build": "npm run build --workspace @termx/ui && npm run build --workspace @termx/mobile",
    "cap:sync": "npm run cap:sync --workspace @termx/mobile",
    "cap:build": "npm run cap:build --workspace @termx/mobile"
  }
}
