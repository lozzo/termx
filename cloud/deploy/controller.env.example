# Copy to /etc/anytty/cloud/controller.env and replace every placeholder.
# Keep this file mode 0600. Do not commit production values.
ANYTTY_CLOUD_DATABASE_URL=postgresql://anytty:REPLACE_DATABASE_PASSWORD@127.0.0.1:5432/anytty?sslmode=require
ANYTTY_CLOUD_CONTROLLER_ID=REPLACE_STABLE_CONTROLLER_ID
ANYTTY_CLOUD_CONTROLLER_LISTEN=0.0.0.0:8443
ANYTTY_CLOUD_CONTROLLER_HEALTH_LISTEN=127.0.0.1:8081
ANYTTY_CLOUD_PUBLIC_ORIGIN=https://cloud.anytty.com
ANYTTY_CLOUD_CONTROLLER_PUBLIC_ADDRESS=controller.anytty.com:8443
ANYTTY_CLOUD_CONTROLLER_SERVER_NAME=controller.anytty.com
ANYTTY_CLOUD_OPERATOR_USERNAME=operator@example.com
ANYTTY_CLOUD_CONFIG_KEY_ID=REPLACE_CONFIG_SIGNING_KEY_ID
ANYTTY_CLOUD_EDGE_ARTIFACT_VERSION=REPLACE_FULL_GIT_COMMIT
ANYTTY_CLOUD_BINDING_KEY_ID=REPLACE_BINDING_SIGNING_KEY_ID
