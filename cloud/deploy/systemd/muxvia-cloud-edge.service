[Unit]
Description=Muxvia Cloud Edge (online development)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muxvia
Group=muxvia
EnvironmentFile=/etc/muxvia/cloud/edge.env
ExecStart=/opt/muxvia/bin/muxvia-cloud-edge --listen=${MUXVIA_CLOUD_EDGE_LISTEN} --controller=${MUXVIA_CLOUD_CONTROLLER_ADDRESS} --controller-server-name=${MUXVIA_CLOUD_CONTROLLER_SERVER_NAME} --edge-id=${MUXVIA_CLOUD_EDGE_ID} --public-tls-cert=/etc/muxvia/cloud/tls/edge-public-fullchain.pem --public-tls-key=/etc/muxvia/cloud/tls/edge-public-key.pem --identity-cert=/etc/muxvia/cloud/tls/edge-identity.pem --identity-key=/etc/muxvia/cloud/tls/edge-identity-key.pem --controller-ca=/etc/muxvia/cloud/tls/controller-ca.pem
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
LimitNOFILE=1048576
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
