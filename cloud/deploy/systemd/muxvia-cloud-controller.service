[Unit]
Description=Muxvia Cloud Controller (online development)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muxvia
Group=muxvia
EnvironmentFile=/etc/muxvia/cloud/controller.env
ExecStart=/opt/muxvia/bin/muxvia-cloud-controller --controller-id=${MUXVIA_CLOUD_CONTROLLER_ID} --grpc-listen=${MUXVIA_CLOUD_CONTROLLER_LISTEN} --http-listen=${MUXVIA_CLOUD_CONTROLLER_HTTP_LISTEN} --health-listen=${MUXVIA_CLOUD_CONTROLLER_HEALTH_LISTEN} --tls-cert=/etc/muxvia/cloud/tls/controller-fullchain.pem --tls-key=/etc/muxvia/cloud/tls/controller-key.pem --controller-ca=/etc/muxvia/cloud/tls/controller-fullchain.pem --edge-ca=/etc/muxvia/cloud/tls/edge-ca.pem --edge-ca-key=/etc/muxvia/cloud/pki/edge-ca-key.pem --public-origin=${MUXVIA_CLOUD_PUBLIC_ORIGIN} --controller-address=${MUXVIA_CLOUD_CONTROLLER_PUBLIC_ADDRESS} --controller-server-name=${MUXVIA_CLOUD_CONTROLLER_SERVER_NAME} --operator-username=${MUXVIA_CLOUD_OPERATOR_USERNAME} --operator-password-file=/etc/muxvia/cloud/secrets/operator-password --config-signing-key=/etc/muxvia/cloud/pki/config-signing-key.pem --config-signing-key-id=${MUXVIA_CLOUD_CONFIG_KEY_ID} --edge-artifact=/opt/muxvia/artifacts/muxvia-cloud-edge --edge-artifact-version=${MUXVIA_CLOUD_EDGE_ARTIFACT_VERSION} --artifact-signing-key=/etc/muxvia/cloud/pki/artifact-signing-key.pem --ticket-signing-key=/etc/muxvia/cloud/pki/ticket-signing-key.pem --ticket-signing-key-id=${MUXVIA_CLOUD_TICKET_KEY_ID} --development-payments
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
LimitNOFILE=1048576
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
