# TERMX_HUB_ADDR listens for Hub HTTP signaling and health endpoints.
TERMX_HUB_ADDR=0.0.0.0:8447

# TERMX_HUB_ID is the unique Hub id reported to web-control.
TERMX_HUB_ID=termx-hub-prod-1

# TERMX_HUB_NAME is a human-readable display name.
TERMX_HUB_NAME="TermX Hub"

# TERMX_HUB_REGION is an operator-defined region label, for example cn or us-west.
TERMX_HUB_REGION=cn

# TERMX_HUB_PUBLIC_HTTP_URL is the browser-reachable Hub HTTP URL reported in heartbeat.
TERMX_HUB_PUBLIC_HTTP_URL=http://114.66.58.243:8447

# TERMX_HUB_CONTROL_URL is the web-control base URL for management heartbeat.
TERMX_HUB_CONTROL_URL=http://localhost:12306

# TERMX_HUB_CONTROL_SECRET must match web-control HUB_SECRET.
TERMX_HUB_CONTROL_SECRET=termx-development-hub-secret-change-me

# TERMX_HUB_STUN_SERVERS is a comma-separated list of STUN URLs advertised to clients.
TERMX_HUB_STUN_SERVERS=stun:stun.l.google.com:19302

# TERMX_HUB_TURN_SERVERS is a comma-separated list of external TURN URLs.
TERMX_HUB_TURN_SERVERS=

# TERMX_HUB_TURN_SHARED_SECRET signs credentials for external TURN URLs.
TERMX_HUB_TURN_SHARED_SECRET=

# TERMX_HUB_TURN_SECRET enables embedded TURN when non-empty.
TERMX_HUB_TURN_SECRET=

# TERMX_HUB_TURN_ADDR is the embedded TURN listen address.
TERMX_HUB_TURN_ADDR=0.0.0.0:3478

# TERMX_HUB_TURN_PUBLIC_IP is required for embedded TURN on a public server.
TERMX_HUB_TURN_PUBLIC_IP=

# TERMX_HUB_HEARTBEAT_INTERVAL controls management heartbeat cadence.
TERMX_HUB_HEARTBEAT_INTERVAL=30s

# TERMX_HUB_MAX_AGENTS is reported to web-control for capacity display.
TERMX_HUB_MAX_AGENTS=1000

# Minimal local check after starting termx-hub:
# curl http://127.0.0.1:8447/api/health
