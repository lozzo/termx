# JWT signing secret. Production deployments must replace this with a random
# secret of at least 32 bytes.
JWT_SECRET=termx-development-jwt-secret-change-me

# Shared secret used only by termx-hub management-plane heartbeat requests.
# This must match termx-hub TERMX_HUB_CONTROL_SECRET.
HUB_SECRET=termx-development-hub-secret-change-me

# Public Web Controller URL. Used in control-plane responses when the service
# needs to refer clients or hubs back to this deployment.
APP_URL=http://localhost:12306

# SQLite database path. The parent directory is created automatically.
SQLITE_PATH=./data/termx-web.sqlite

# GitHub OAuth is optional. Leave both empty to disable GitHub login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
