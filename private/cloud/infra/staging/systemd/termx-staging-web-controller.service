[Unit]
Description=TermX staging Next.js Web Controller
After=termx-staging-web-controller-bff.service
Requires=termx-staging-web-controller-bff.service

[Service]
Type=simple
User=termx-staging
Group=termx-staging
WorkingDirectory=/opt/termx-staging/web-controller/private/cloud/web-controller/web
Environment=HOSTNAME=127.0.0.1
Environment=PORT=41000
Environment=WEB_CONTROLLER_BFF_URL=http://127.0.0.1:41004
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
