[Unit]
Description=TermX staging public daemon
After=termx-staging-daemon-companion.service
Requires=termx-staging-daemon-companion.service

[Service]
Type=simple
User=termx-staging
Group=termx-staging
StateDirectory=termx-staging
RuntimeDirectory=termx-staging
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
WorkingDirectory=/var/lib/termx-staging/files
Environment=XDG_STATE_HOME=/var/lib/termx-staging/daemon-state
Environment=TERMX_CLOUD_COMPANION_SOCKET=/run/termx-staging/daemon-companion.sock
ExecStart=/opt/termx-staging/bin/termx --socket /run/termx-staging/daemon.sock daemon --cloud
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/termx-staging /run/termx-staging

[Install]
WantedBy=multi-user.target
