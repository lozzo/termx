{
  "name": "@termx/web-controller",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e:hub007": "node e2e/run-hub007.mjs",
    "proto": "mkdir -p src/generated && protoc --es_out=src/generated --es_opt=target=ts,import_extension=none -I ../../../../proto ../../../../proto/cloudpb/*.proto && perl -0pi -e 's/\\s*\\z/\\n/' src/generated/cloudpb/*_pb.ts"
  },
